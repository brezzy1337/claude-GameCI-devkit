{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/guard-unity-paths.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(claude-unity-devkit:)?security-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/notify-slack.sh 'ship: review stage complete'"
          }
        ]
      }
    ]
  }
}
