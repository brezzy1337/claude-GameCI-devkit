# Unity project .gitattributes — place next to .gitignore at the Unity project root.
# Requires Git LFS (https://git-lfs.com): run `git lfs install --local` once per clone.
# CI must check out with LFS enabled (actions/checkout `lfs: true`), or builds import pointer
# files instead of assets.

# ---- Line endings --------------------------------------------------------------------------
* text=auto

# ---- Code and text config ------------------------------------------------------------------
*.cs          text diff=csharp
*.asmdef      text
*.asmref      text
*.json        text
*.xml         text
*.yml         text
*.yaml        text
*.md          text
*.shader      text
*.hlsl        text
*.cginc       text
*.compute     text
*.uss         text
*.uxml        text
*.inputactions text
*.shadergraph text
*.shadersubgraph text

# ---- Unity YAML (requires ProjectSettings: Force Text serialization) -----------------------
# merge=unityyamlmerge uses Unity's Smart Merge. Enable it once per machine:
#   git config merge.unityyamlmerge.name "Unity SmartMerge (UnityYamlMerge)"
#   git config merge.unityyamlmerge.driver '"<path-to-Editor>/Data/Tools/UnityYAMLMerge" merge -h -p --force %O %B %A %A'
#   git config merge.unityyamlmerge.recursive binary
*.meta        text merge=unityyamlmerge
*.unity       text merge=unityyamlmerge
*.prefab      text merge=unityyamlmerge
*.asset       text merge=unityyamlmerge
*.mat         text merge=unityyamlmerge
*.anim        text merge=unityyamlmerge
*.controller  text merge=unityyamlmerge
*.overrideController text merge=unityyamlmerge
*.physicMaterial text merge=unityyamlmerge
*.physicsMaterial2D text merge=unityyamlmerge
*.playable    text merge=unityyamlmerge
*.mask        text merge=unityyamlmerge
*.brush       text merge=unityyamlmerge
*.flare       text merge=unityyamlmerge
*.fontsettings text merge=unityyamlmerge
*.guiskin     text merge=unityyamlmerge
*.giparams    text merge=unityyamlmerge
*.renderTexture text merge=unityyamlmerge
*.spriteatlas text merge=unityyamlmerge
*.spriteatlasv2 text merge=unityyamlmerge
*.terrainlayer text merge=unityyamlmerge
*.mixer       text merge=unityyamlmerge
*.shadervariants text merge=unityyamlmerge
*.preset      text merge=unityyamlmerge
*.lighting    text merge=unityyamlmerge
*.vfx         text merge=unityyamlmerge

# ---- Git LFS: binary assets ----------------------------------------------------------------
